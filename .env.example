# Copy to .env and fill in. Never commit .env.
# All services are free tiers that need no card.

# Supabase (dev project, Mumbai/Singapore region)
SUPABASE_URL=                 # https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... (safe for the frontend)
SUPABASE_SECRET_KEY=          # sb_secret_... (backend only, never in the frontend or git)
SUPABASE_DB_URL=              # Session pooler connection string, with your password filled in

# Neo4j AuraDB Free
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Cloud LLMs (free tiers)
GEMINI_API_KEY=          # Google AI Studio key (not Google Cloud / Vertex)
GROQ_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GPU machine (Tailscale Funnel → Caddy gateway)
GPU_GATEWAY_URL=          # e.g. https://<machine>.<tailnet>.ts.net
GATEWAY_KEY=              # long random string; sent as X-HappyGut-Key
MCP_BEARER_TOKEN=

# Data APIs (free keys)
USDA_API_KEY=             # api.data.gov
NCBI_API_KEY=

# n8n + web push
N8N_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
