# Copy to .env and fill in. Never commit .env.
# All services are free tiers that need no card.
# Put each value directly after "=" with no spaces and no quotes.

# --- Supabase (Project Settings, Connect button) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# sb_publishable_...  (safe for the frontend)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...  (backend only)
SUPABASE_SECRET_KEY=
# Session pooler connection string with your database password filled in
SUPABASE_DB_URL=

# --- Neo4j AuraDB Free (from the downloaded credentials file) ---
# e.g. neo4j+s://abc12345.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Cloud LLMs (free tiers) ---
# Google AI Studio key (not Google Cloud / Vertex)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Langfuse (EU region host shown; US is https://us.cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Backend options (defaults shown; all optional) ---
# Model names: Gemini via Google AI Studio, everything else via Groq. Each falls back to the second.
# At start-up the backend checks these against the models your keys can use and replaces any
# that aren't available (RESOLVE_MODELS=false turns that off). See them with:
#   uv run python -m happygut_api.diagnose --list
# PERCEPTION_MODEL=gemini-flash-lite-latest
# PERCEPTION_FALLBACK_MODEL=gemini-flash-latest
# EXPLANATION_MODEL=gemini-flash-lite-latest
# EXPLANATION_FALLBACK_MODEL=openai/gpt-oss-120b
# Seconds each model attempt may take before the next model is tried
# MODEL_TIMEOUT_S=12
# PII layers on top of the Bangladesh rules (the Docker image turns Presidio on)
# PII_PRESIDIO=false
# PII_BENGALI_NER_MODEL=
# Demo mode: one-tap entry to an account with sample data, kept in memory (no Supabase needed)
# DEMO_MODE=false
# Development only: also load draft seeds (a verdict carries an "unreviewed" note when a draft is loaded)
# INCLUDE_DRAFT_SEEDS=false
# Browser origins allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]

# --- Secrets we generate ---
# Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=
N8N_ENCRYPTION_KEY=

# --- Data APIs (free keys) ---
USDA_API_KEY=
NCBI_API_KEY=

# --- Web push (generated later) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
