# Copy to .env and fill in. Never commit .env.
# All services are free tiers that need no card.
# Put each value directly after "=" with no spaces and no quotes.

# --- Supabase (Project Settings, Connect button) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# sb_publishable_...  (safe for the frontend)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...  (backend only)
SUPABASE_SECRET_KEY=
# Session pooler connection string with your database password filled in
SUPABASE_DB_URL=

# --- Neo4j AuraDB Free (from the downloaded credentials file) ---
# e.g. neo4j+s://abc12345.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Cloud LLMs (free tiers) ---
# Google AI Studio key (not Google Cloud / Vertex)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Langfuse (EU region host shown; US is https://us.cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Secrets we generate ---
# Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=
N8N_ENCRYPTION_KEY=

# --- Data APIs (free keys) ---
USDA_API_KEY=
NCBI_API_KEY=

# --- Web push (generated later) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
