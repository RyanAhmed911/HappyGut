# API-key gateway in front of the GPU machine's services.
# Ollama has no authentication of its own, so it is never exposed directly.
# Clients must send:  X-HappyGut-Key: <GATEWAY_KEY>
#
# Runs with host networking so it can reach the natively installed Ollama on 127.0.0.1:11434.
# Listens on localhost only; Tailscale Funnel publishes it (tailscale funnel --bg 8080).

{
	admin off
}

http://127.0.0.1:8080 {
	handle /health {
		respond "ok" 200
	}

	route {
		@unauthorized not header X-HappyGut-Key {$GATEWAY_KEY}
		respond @unauthorized "unauthorized" 401

		handle_path /llm/* {
			reverse_proxy {$OLLAMA_UPSTREAM:127.0.0.1:11434}
		}

		handle_path /embed/* {
			reverse_proxy {$RERANK_UPSTREAM:127.0.0.1:8001}
		}

		# Enabled in Step 1:
		# handle_path /mcp/* {
		# 	reverse_proxy 127.0.0.1:8100
		# }

		respond "not found" 404
	}

	log {
		output stdout
		format json
	}
}
