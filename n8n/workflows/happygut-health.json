{
  "id": "happygutHealth01",
  "versionId": "98fd0858-921e-51f0-ae37-8ff1b2394950",
  "name": "HappyGut: keep awake and check health",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "8a41525a-cc09-518d-b964-464fba7f8349",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "2abf28ef-17cb-5155-8d33-322ca026677a",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.HAPPYGUT_API_URL }}/v1/health",
        "options": {
          "timeout": 120000
        }
      },
      "id": "aa6264a5-2f44-55ba-98e9-e49ce148a3c2",
      "name": "Check health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c467b32d-f1df-5ebd-b6a5-45929984ac47",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ecb4a6c5-9817-5f19-b633-b5f597dfc377",
              "leftValue": "={{ $json.knowledge.rule_cards }}",
              "rightValue": 25,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "8f1da94f-6922-56f4-b1f3-9180fd420550",
              "leftValue": "={{ $json.knowledge.reviewed_only }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b60aaad9-8526-59be-8260-3789d846546c",
      "name": "Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {},
      "id": "9479a8e9-a654-539e-9edb-c52bfb50a6e9",
      "name": "All good",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "=HappyGut health check failed: {{ JSON.stringify($json) }}"
      },
      "id": "10094c6a-eefa-5ca2-87f9-e80098a3d2f7",
      "name": "Fail the run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        200
      ]
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Check health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Check health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check health": {
      "main": [
        [
          {
            "node": "Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthy?": {
      "main": [
        [
          {
            "node": "All good",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka",
    "saveManualExecutions": true
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Pings /v1/health every 30 minutes. Keeps the Hugging Face Space awake for judges and fails the run if the knowledge layer isn't fully loaded and reviewed."
  },
  "tags": []
}
