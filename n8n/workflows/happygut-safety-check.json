{
  "id": "happygutSafety01",
  "versionId": "00bdc573-f478-57ff-b9a9-3128fd5b487c",
  "name": "HappyGut: weekly safety self-check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 7 * * 1"
            }
          ]
        }
      },
      "id": "fe1fa877-618a-5439-946a-1084fa2cf69e",
      "name": "Every Monday 07:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "2abf28ef-17cb-5155-8d33-322ca026677a",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HAPPYGUT_API_URL }}/v1/jobs/selfcheck",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "id": "bab0c2b2-93bf-5c56-a803-bf4556c1b44c",
      "name": "Self-check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "happygutJobsToken",
          "name": "HappyGut jobs token"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "72c1d0bb-5975-5496-8b83-0e6ba8da5d90",
              "leftValue": "={{ $json.passed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8ff511bb-0b21-5774-a7c8-f4037e32019b",
      "name": "All checks passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {},
      "id": "9479a8e9-a654-539e-9edb-c52bfb50a6e9",
      "name": "All good",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "=HappyGut safety self-check failed: {{ JSON.stringify($json.checks) }}"
      },
      "id": "10094c6a-eefa-5ca2-87f9-e80098a3d2f7",
      "name": "Fail the run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        200
      ]
    }
  ],
  "connections": {
    "Every Monday 07:10": {
      "main": [
        [
          {
            "node": "Self-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Self-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Self-check": {
      "main": [
        [
          {
            "node": "All checks passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All checks passed?": {
      "main": [
        [
          {
            "node": "All good",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka",
    "saveManualExecutions": true
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Weekly: runs the red-flag suite, verdict reproducibility, the stricture rule and the dish-name index on the live backend; fails the run if any check fails."
  },
  "tags": []
}
